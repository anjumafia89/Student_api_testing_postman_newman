            "exec": [
              "//Random firstname\r",
              "var first_name = pm.variables.replaceIn(\"{{$randomFirstName}}\")\r",
              "console.log(first_name)\r",
              "pm.environment.set(\"first_name\", first_name);\r",
              "\r",
              "//Random middlename\r",
              "/* var middle_name = pm.variables.replaceIn(\"{{$randomFirstName}}\")\r",
              "console.log(middle_name)\r",
              "pm.environment.set(\"middle_name\", middle_name);*/\r",
              "\r",
              "var middleName=[\"Ray\",\"Jun\",\"Paul\",\"Gomez\",\"Biebar\",\"Ann\",\"Callum\",\"Atticus\",\"Asher\"]\r",
              "var middle_name = middleName[Math.floor(Math.random() * middleName.length)];\r",
              "pm.environment.set(\"middle_name\", middle_name);\r",
              "console.log(middle_name)\r",
              "\r",
              "//Random last name\r",
              "var last_name = pm.variables.replaceIn(\"{{$randomLastName}}\")\r",
              "console.log(last_name)\r",
              "pm.environment.set(\"last_name\", last_name);\r",
              "\r",
              "//Date of birth\r",
              "const date = require(\"moment\");\r",
              "//random date 2020 theke 2021 obdi date randomly generate hobe\r",
              "const startDate = date(\"2000-01-01\");\r",
              "const endDate = date(\"2021-12-31\");\r",
              "\r",
              "//difference\r",
              "const diff = endDate.diff(startDate, 'days');\r",
              "const randomDays = Math.floor(Math.random() * diff);\r",
              "//start date theke random date start korbe\r",
              "var date_of_birth = startDate.add(randomDays, 'd').format(\"YYYY-MM-DD\");\r",
              "pm.environment.set(\"date_of_birth\", date_of_birth);\r",
              "console.log(date_of_birth)"
            ],
